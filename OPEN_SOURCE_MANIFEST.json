{
  "schema_version": 1,
  "standard": "VOS-OPEN-PAYLOAD-1",
  "state": "LOCAL_RELEASE_CANDIDATE",
  "software_license": "Apache-2.0",
  "documentation_license": "CC-BY-4.0",
  "include": [
    ".github/**",
    ".gitleaks.toml",
    ".zenodo.json",
    "LICENSE",
    "DOCUMENTATION_LICENSE.md",
    "NOTICE",
    "README.md",
    "llms.txt",
    "AGENTS.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "SECURITY.md",
    "GOVERNANCE.md",
    "ROADMAP.md",
    "SUPPORT.md",
    "TRADEMARK.md",
    "CHANGELOG.md",
    "CITATION.cff",
    "OPEN_SOURCE_MANIFEST.json",
    "PLATFORM_CATALOG.md",
    "CANON_INTEGRATION.md",
    "VIRIDISOS_NETWORK_EFFECT_STANDARD.md",
    "pyproject.toml",
    "catalog.py",
    "demo.py",
    "viridis_platform.py",
    "run_all_tests.sh",
    "api/**/*.py",
    "certification/**/*.py",
    "modules/**/*.py",
    "modules/_template/**",
    "runtime/**/*.py",
    "runtime/**/*.json",
    "tests/**/*.py",
    "tools/**/*.py"
  ],
  "exclude": [
    "**/__pycache__/**",
    "**/*.pyc",
    "integration/**",
    "adapters/**",
    "network_snapshots/**",
    "NETWORK_EFFECT_EVIDENCE.json",
    "NETWORK_EFFECT_REGISTRY.json",
    "VIRIDISOS_NETWORK_STATE.json",
    "VIRIDISOS_NETWORK_STATE.md",
    "tests/test_network_state.py",
    "tests/test_diagnostic_delivery_kit.py",
    "*BUSINESS*",
    "*HANDOFF*",
    "*DEPLOY*"
  ],
  "protected_or_unreleased": [
    "production trust-root signing and revocation",
    "certification mark authorization",
    "settlement and toll implementation",
    "customer and partner systems",
    "deployment credentials and infrastructure"
  ],
  "external_mutation": false
}
